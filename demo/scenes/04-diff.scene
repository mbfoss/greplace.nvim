# Preview the write as a diff before anything reaches a buffer.
size 100x33
cwd $GREPLACE_DEMO_WORK
init ../init.lua
out ../out/04-diff.gif
cast ../out/04-diff.cast

font-family SauceCodePro NF
font-dir ~/Library/Fonts
font-size 17
line-height 1.19
theme nord
fps 20
idle-time-limit 2
last-frame-duration 2

keycast on
keycast-width 24

caption Search and edit the result list
sleep 500ms
type :Gsearch load_config
key <CR>
wait [0-9]+ files \([0-9]+ changed\)
sleep 800ms
type :%s/load_config/read_config/g
key <CR>
wait \([1-9][0-9]* changed\)
sleep 900ms

caption :Greplace diff previews the write
type :Greplace diff
key <CR>
wait \+\+\+ b/
sleep 1500ms
key j
key j
sleep 900ms

caption Nothing is touched until :w
key :q<CR>
wait [0-9]+ changed
sleep 700ms
key :w<CR>
wait \(0 changed\)
sleep 1000ms
